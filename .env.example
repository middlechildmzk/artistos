# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stable public ArtistOS origin used for OAuth cookies and callbacks.
# This must be a persistent HTTPS hostname, not a one-off preview deployment URL.
ARTISTOS_PUBLIC_ORIGIN=https://artistos.example.com

# Server-only Google OAuth credentials for YouTube source connections.
# Configure this exact authorized redirect URI in Google Cloud:
# ${ARTISTOS_PUBLIC_ORIGIN}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server-only 32-byte AES key for OAuth token encryption.
# Generate a hex value with: openssl rand -hex 32
ARTISTOS_TOKEN_ENCRYPTION_KEY=
