# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Server-only Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=

# ArtistOS server configuration
ARTISTOS_PUBLIC_ORIGIN=https://artistos.example.com
ARTISTOS_TOKEN_ENCRYPTION_KEY=

# Google and YouTube OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional provider credentials
LASTFM_API_KEY=
TICKETMASTER_API_KEY=

# Never put server secrets in NEXT_PUBLIC_ variables.
