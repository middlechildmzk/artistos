# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Google OAuth credentials for YouTube source connections.
# Configure the authorized redirect URI as:
# https://YOUR_ARTISTOS_DOMAIN/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server-only 32-byte AES key for OAuth token encryption.
# Generate a hex value with: openssl rand -hex 32
ARTISTOS_TOKEN_ENCRYPTION_KEY=
