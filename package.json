{
  "name": "artistos",
  "version": "0.2.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs');const s=fs.readFileSync('package-lock.json','utf8');fs.writeFileSync('app/api/oauth/lockfile/generated.ts','export default '+JSON.stringify(s)+';\\n')\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.29.0",
    "eslint-config-next": "16.2.11",
    "typescript": "5.8.3"
  }
}
